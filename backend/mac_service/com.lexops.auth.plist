<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the LexOps Mac auth service.
  Install: cp com.lexops.auth.plist ~/Library/LaunchAgents/
           launchctl load ~/Library/LaunchAgents/com.lexops.auth.plist
  Logs:    tail -f /tmp/lexops-auth.log
  Stop:    launchctl unload ~/Library/LaunchAgents/com.lexops.auth.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lexops.auth</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_PATH__</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>backend.mac_service.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8765</string>
    <string>--log-level</string>
    <string>info</string>
  </array>

  <!-- Root of the GestorJuridico repo — so "backend.mac_service" resolves -->
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart automatically if the process dies -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/lexops-auth.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/lexops-auth.err</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TELEGRAM_BOT_TOKEN</key>
    <string>__TELEGRAM_BOT_TOKEN__</string>

    <key>TELEGRAM_ALLOWED_USER_IDS</key>
    <string>5152275140</string>

    <!-- Generate once: python3 -c "import secrets; print(secrets.token_hex(32))" -->
    <key>AUTH_SECRET</key>
    <string>__AUTH_SECRET__</string>

    <!-- Optional overrides -->
    <!-- <key>PORT</key><string>8765</string> -->
    <!-- <key>SESSION_FILE</key><string>/Users/you/.lexops/jusbr_session.json</string> -->
  </dict>
</dict>
</plist>
