<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lexops.informativostf</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lucasjudice/ClaudeCode/GestorJuridico/backend/.venv/bin/python</string>
        <string>/Users/lucasjudice/ClaudeCode/GestorJuridico/backend/scripts/sync_informativo_stf_local.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lucasjudice/ClaudeCode/GestorJuridico/backend</string>

    <!-- Roda só 1x por dia, de tarde (o script decide se é segunda-feira e
         se ainda não rodou esta semana — qualquer outro dia, sai sem fazer
         nada em menos de 1s). Isso não pesa o computador: StartCalendarInterval
         só dispara nesse horário, não fica checando o tempo todo. RunAtLoad
         também dispara ao carregar — cobre o Mac ter ficado desligado nessa
         hora: na próxima vez que ligar/fizer login, o launchd já roda e,
         se for segunda, pega o atraso. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/com.lexops.informativostf.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.lexops.informativostf.err.log</string>
</dict>
</plist>
